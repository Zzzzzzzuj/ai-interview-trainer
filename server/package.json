{
  "name": "interview-practice-server",
  "private": true,
  "version": "0.1.0",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --name init",
    "import:questions": "tsx scripts/importQuestions.ts",
    "seed:local": "tsx scripts/seedLocalQuestions.ts",
    "tag:questions": "tsx scripts/tagQuestions.ts",
    "demo:review-answer": "tsx scripts/demoReviewAnswer.ts",
    "cleanup:invalid-questions": "tsx scripts/cleanupInvalidQuestions.ts",
    "clean:questions": "tsx scripts/cleanQuestionSemantics.ts",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "6.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.3",
    "prisma": "6.7.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  }
}
